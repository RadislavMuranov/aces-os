{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Read|Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/aces-hook-engine.mjs",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/aces-hook-engine.mjs",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
