{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Read|Write|Edit",
        "hooks": [
          {
            "type": "command",
            "shell": "powershell",
            "command": "& node \"$env:CLAUDE_PROJECT_DIR\\.claude\\hooks\\aces-hook-engine.mjs\" pretool",
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "powershell",
            "command": "& node \"$env:CLAUDE_PROJECT_DIR\\.claude\\hooks\\aces-hook-engine.mjs\" stop",
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      }
    ]
  }
}
